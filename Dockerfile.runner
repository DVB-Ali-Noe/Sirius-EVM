# Image du runner confidentiel (CVM Phala). Son digest est mesuré par le compose attesté :
# elle doit pouvoir être reconstruite à l'identique depuis un commit (audit REP-01, REP-02).
#
# - Base épinglée par digest : l'index multi-architecture de `node:22-bookworm-slim` lu le
#   24 oct. 2026. Un tag seul bouge à chaque correctif Debian ou Node. Pour monter de version :
#   `docker buildx imagetools inspect node:22-bookworm-slim`, puis remplacer le digest dans les
#   deux FROM. Toute mise à jour change l'image, donc le compose et la capture RA-TLS.
# - Dates figées : le CI passe SOURCE_DATE_EPOCH (date du commit) et `rewrite-timestamp=true`.
#   Reconstruction locale, depuis un export LF du commit (`git -c core.autocrlf=false archive`) :
#     SOURCE_DATE_EPOCH=$(git log -1 --format=%ct <commit>) docker buildx build \
#       --platform linux/amd64 --no-cache --provenance=false --sbom=false \
#       --build-arg SOURCE_DATE_EPOCH -f Dockerfile.runner \
#       --output type=oci,dest=runner.tar,rewrite-timestamp=true .
# - Les deux fichiers d'état de pnpm portent l'heure de l'installation et ne servent pas à
#   l'exécution (aucun compose n'appelle pnpm) : ils sont supprimés après l'installation.
FROM node:22-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d AS dependencies

ENV PNPM_CONFIG_FETCH_RETRIES=5
ENV PNPM_CONFIG_FETCH_RETRY_MAXTIMEOUT=120000
ENV PNPM_CONFIG_FETCH_TIMEOUT=300000
ENV PNPM_CONFIG_NETWORK_CONCURRENCY=8
WORKDIR /workspace
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY prisma ./prisma
RUN --mount=type=cache,id=sirius-runner-corepack,target=/root/.cache/node/corepack,sharing=locked \
    --mount=type=cache,id=sirius-runner-pnpm-store,target=/root/.local/share/pnpm/store,sharing=locked \
    pnpm install --prod --frozen-lockfile --ignore-scripts \
    && rm -f node_modules/.modules.yaml node_modules/.pnpm-workspace-state-v1.json

FROM node:22-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d AS runner

ENV NODE_ENV=production
ENV NODE_OPTIONS="--conditions=react-server --max-old-space-size=384"
WORKDIR /workspace

COPY --from=dependencies --chown=node:node /workspace/node_modules ./node_modules
COPY --from=dependencies --chown=node:node /workspace/package.json /workspace/tsconfig.json ./
COPY --chown=node:node src ./src
COPY --chown=node:node scripts/runner-budget.ts ./scripts/runner-budget.ts
COPY --chown=node:node scripts/runner-replay.ts ./scripts/runner-replay.ts
COPY --chown=node:node scripts/initialize-runner-volume.ts ./scripts/initialize-runner-volume.ts
COPY --chown=node:node scripts/add-runner-trial-wallets.ts ./scripts/add-runner-trial-wallets.ts
COPY --chown=node:node scripts/update-runner-billing-policy.ts ./scripts/update-runner-billing-policy.ts
COPY --chown=node:node scripts/renew-runner-budget-policy.ts ./scripts/renew-runner-budget-policy.ts
COPY --chown=node:node scripts/runner-transactions.ts ./scripts/runner-transactions.ts
COPY --chown=node:node scripts/check-runner-finality.ts ./scripts/check-runner-finality.ts
RUN mkdir -p /var/lib/sirius-runner/replay /var/lib/sirius-runner/budget \
    && chmod 700 /var/lib/sirius-runner/budget /var/lib/sirius-runner/replay \
    && chown -R node:node /var/lib/sirius-runner

USER node
EXPOSE 4100
CMD ["node", "--import", "tsx", "src/runner/start.ts"]
