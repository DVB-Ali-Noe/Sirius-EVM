# ─────────────────────────────────────────────────────────────
# Sirius — template d'environnement
# Copier en .env.local et remplir : cp .env.example .env.local
# Ne jamais commiter de vraie valeur ici.
# ─────────────────────────────────────────────────────────────

# Base de données (Prisma + PostgreSQL)
# Postgres. Le SQLite d'origine ne convient ni au serverless, qui n'a pas de disque
# persistant, ni à un reaper qui tourne dans un autre processus que l'application.
DATABASE_URL="postgresql://user:motdepasse@hote:5432/sirius?schema=public"
# Pool par instance. Chaque instance serverless froide ouvre le sien : une valeur
# généreuse épuise les connexions de la base avant d'être utile.
DATABASE_POOL_MAX="5"

# ─────────────────────────────────────────────────────────────
# EVM — Robinhood Chain (Arbitrum Nitro). Rail cible.
# testnet 46630 (0xb626) · mainnet 4663 (0x1237) · gas en ETH natif
#
# Le projet cible le TESTNET. Rien n'y coûte d'argent réel, les contrats sont
# redéployables librement et aucun audit externe n'est requis pour en poser un.
# Le mainnet est une décision distincte : le script de déploiement le refuse
# sans SIRIUS_ALLOW_MAINNET=true, et il suppose au minimum la séparation de
# domaine du préimage d'escrow (cf. l'avertissement dans SiriusEscrow.sol).
# ─────────────────────────────────────────────────────────────
EVM_NETWORK="testnet"                    # testnet | mainnet
EVM_RPC_URL=""                           # vide = RPC public de la chaîne
NEXT_PUBLIC_EVM_NETWORK="testnet"        # doit correspondre à EVM_NETWORK, sinon signatures rejetées

# Adresses des contrats Sirius, renseignées après déploiement.
NEXT_PUBLIC_SIRIUS_ESCROW_ADDRESS=""
NEXT_PUBLIC_SIRIUS_KYB_ADDRESS=""
NEXT_PUBLIC_SIRIUS_DATASET_ADDRESS=""
NEXT_PUBLIC_SIRIUS_USDC_ADDRESS=""

# Configuration privée du runner EVM (ne jamais exposer dans le navigateur).
SIRIUS_ESCROW_ADDRESS=""
SIRIUS_USDC_ADDRESS=""
SIRIUS_USDC_CODE_HASH=""               # keccak256 du bytecode USDC, requis au déploiement
SIRIUS_KYB_ADDRESS=""
SIRIUS_DATASET_ADDRESS=""
SIRIUS_LEGACY_ESCROW_ADDRESSES=""      # anciens escrows approuvés, même réseau, séparés par des virgules
SIRIUS_MIGRATION_ESCROW_ADDRESSES=""   # préflight uniquement : tous les escrows utilisés par cette base

# Déploiement des contrats (jamais chargé par l'application, uniquement par Hardhat).
ROBINHOOD_DEPLOYER_KEY=""
ROBINHOOD_TESTNET_RPC=""
ROBINHOOD_MAINNET_RPC=""
SIRIUS_KYB_ADMIN=""                    # adresse de gouvernance distincte
SIRIUS_KYB_VERIFIER=""                 # adresse du service KYB externe/HSM
SIRIUS_LOCK_AUTHORIZER=""              # adresse publique attendue du runner : déploiement v6, activation CVM et smoke
SIRIUS_SMOKE_PROVIDER_ADDRESS=""       # provider déjà attesté, utilisé par contracts:smoke
SIRIUS_SMOKE_DATASET_ID=""              # identifiant d'un titre EVM live de ce provider, utilisé par contracts:smoke
SIRIUS_SMOKE_MODEL_ID="linear_regression" # linear_regression | logistic_regression

# On-ramp fiat (MoonPay sandbox) — inc.3b
NEXT_PUBLIC_MOONPAY_PUBLISHABLE_KEY=""  # pk_test_...
MOONPAY_SECRET_KEY=""                    # sk_test_... (signature d'URL, serveur)

# Le signer KYB est externe à l'application : HSM, KMS ou prestataire KYB.
# Ne jamais injecter sa clé privée dans Next.js ni dans le runner.

# IPFS / Pinata
PINATA_JWT=""
PINATA_GATEWAY="https://gateway.pinata.cloud"

# Chiffrement datasets (AES-256-GCM) — clé maître 32 bytes en base64
# Générer : openssl rand -base64 32
SIRIUS_MASTER_KEY=""

# Auth API — indépendant de la master key TEE
# Générer : openssl rand -base64 32
SIRIUS_SESSION_SECRET=""

# TEE — Phala dstack (stub swappable en dev)
TEE_MODE="stub"            # stub | phala
SIRIUS_REQUIRE_PHALA="false" # pipeline : true sur main, même sur testnet ; false sur staging/dev
# En mode phala : URL du simulateur dstack en dev ; en CVM, laissé vide → socket du guest-agent
# (/var/run/dstack.sock). La master key est alors dérivée dans l'enclave (getKey), pas via env.
# ⚠ phala + simulateur est REFUSÉ en production (clé non scellée matériellement).
DSTACK_SIMULATOR_ENDPOINT=""
# Mesures épinglées après validation du déploiement CVM. Elles vivent dans l’environnement
# de l’application Next qui vérifie le runner, jamais dans le compose de la CVM (sinon le
# compose_hash changerait au moment même de son épinglage).
SIRIUS_EXPECTED_MRTD=""
SIRIUS_EXPECTED_RTMR3=""
SIRIUS_EXPECTED_COMPOSE_HASH=""
# Empreinte SHA-256 canonique de la signature_chain renvoyée avec sirius/master/v1.
SIRIUS_EXPECTED_MASTER_KEY_CHAIN_SHA256=""
# SHA-256 de la clé P-256 brute d'ingestion, affiché au boot du runner puis épinglé au build Next.
NEXT_PUBLIC_SIRIUS_INGRESS_KEY_SHA256=""

# Runner confidentiel isolé (inc.3d-B, D-25) : service qui détient la master key enclave.
# En production : URL HTTPS en passthrough vers la CVM ; le certificat et sa clé sont générés
# par dstack dans la CVM puis authentifiés par quote TDX avant tout envoi métier.
# Vide = fallback in-process DEV uniquement.
RUNNER_URL=""
RUNNER_PORT="4100"
RUNNER_BOOTSTRAP_ONLY="false" # CVM uniquement : expose l’identité RA-TLS, refuse toutes les opérations métier
RUNNER_TLS_HOSTNAME=""       # hostname exact de RUNNER_URL, obligatoire dans la CVM de production
RUNNER_TLS_ALT_NAMES=""      # SAN supplémentaires séparés par des virgules, optionnel
RUNNER_TLS_ENABLED="false"   # production = toujours actif ; utile avec un simulateur en développement
RUNNER_TRANSPORT_SECRET=""  # authentification du canal Next↔runner, aucun droit métier
RUNNER_REPLAY_DIR=""         # volume persistant runner ; obligatoire en production
RUNNER_MAX_BODY_MB="24"      # plafond transport runner ; upload applicatif limité à 3 MiB
RUNNER_MAX_CONNECTIONS="32"
RUNNER_MAX_CONCURRENT_REQUESTS="8"
RUNNER_MAX_CONCURRENT_UPLOADS="1"
RUNNER_MAX_CONCURRENT_JOBS="1"
RUNNER_TRAINING_TIMEOUT_MS="15000"
SIRIUS_APP_ORIGIN="http://localhost:3000" # origine autorisée dans les délégations wallet
SIRIUS_APP_ORIGIN_ALIASES="" # origines supplémentaires explicites, séparées par des virgules
NEXT_PUBLIC_SIRIUS_APP_ORIGIN="" # canonique au build ; vide en local = origine du navigateur
SIRIUS_MAX_CONCURRENT_UPLOADS="2" # plafond app avant lecture des enveloppes chiffrées
# Reaper en cours de processus : pratique en développement, sans effet en serverless
# où aucun processus ne survit entre deux requêtes. En production, le reaper tourne
# comme worker autonome — voir `pnpm reaper:start` et src/worker/reaper.ts.
SIRIUS_REAPER_ENABLED="true" # réconciliation autonome des prêts et escrows bloqués
SIRIUS_REAPER_INTERVAL_MS="30000"
SIRIUS_TRUST_PROXY_HEADERS="false" # true seulement si l’ingress écrase X-Real-IP
SIRIUS_INGRESS_RATE_LIMITED="false" # production : limites distribuées IP/globales imposées par l’ingress

# ─── Mode démonstration ───────────────────────────────────────────────────────
# Construit comme la production, configuré pour un réseau de test, sans enclave
# réelle. Sans lui, une instance servie publiquement exige un TEE attesté et le
# mainnet — ce qui rend toute démonstration impossible avant ce jalon.
# Valeur exacte « demo » : un « 1 » ou un « true » laissé par mégarde n activerait rien.
# Interdit sur mainnet, où l instance repasse par la porte stricte.
SIRIUS_DEPLOYMENT_MODE=""
NEXT_PUBLIC_SIRIUS_DEPLOYMENT_MODE="" # doit valoir « demo » aussi : le bandeau en dépend
