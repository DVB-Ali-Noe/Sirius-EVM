# À compléter dans un fichier privé 0600 ; ne pas activer avec ces placeholders.
PHALA_DEMO_PROFILE=REPLACE_PROFILE
PHALA_DEMO_CVM_ID=REPLACE_CVM_ID
PHALA_DEMO_APP_ID=REPLACE_APP_ID
PHALA_DEMO_STATE_FILE=/var/lib/sirius-ops/phala-demo/state.json
PHALA_DEMO_FUNDING_FILE=/etc/sirius/operations/phala-demo-funding.json
PHALA_DEMO_BIND=127.0.0.1
PHALA_DEMO_PORT=4443
PHALA_DEMO_TLS_CERT=/etc/sirius/operations/tls/fullchain.pem
PHALA_DEMO_TLS_KEY=/etc/sirius/operations/tls/privkey.pem
PHALA_DEMO_CONTROLLER_SECRET=REPLACE_BASE64_32_BYTES
RUNNER_DEMO_CONTROL_SECRET=REPLACE_DISTINCT_BASE64_32_BYTES
SIRIUS_DEMO_OPERATORS=REPLACE_NOE_ADDRESS,REPLACE_ALI_ADDRESS
RUNNER_URL=https://REPLACE_RUNNER_ORIGIN
SIRIUS_APP_ORIGIN=https://REPLACE_DEMO_ORIGIN
SIRIUS_EXPECTED_MRTD=REPLACE_VERIFIED_MRTD
SIRIUS_EXPECTED_RTMR3=REPLACE_VERIFIED_RTMR3
SIRIUS_EXPECTED_COMPOSE_HASH=REPLACE_VERIFIED_COMPOSE_HASH
SIRIUS_EXPECTED_MASTER_KEY_CHAIN_SHA256=REPLACE_VERIFIED_CHAIN_HASH
NEXT_PUBLIC_SIRIUS_INGRESS_KEY_SHA256=REPLACE_VERIFIED_INGRESS_HASH
