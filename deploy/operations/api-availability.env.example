# À compléter dans un fichier privé 0600 ; ne pas activer avec ces placeholders.
# Jamais sur l'instance de démonstration : SIRIUS_PHALA_DEMO=true fait refuser le démarrage.
SIRIUS_API_AVAILABILITY=true
SIRIUS_API_AVAILABILITY_IDLE_MINUTES=45
SIRIUS_API_AVAILABILITY_POLL_SECONDS=60
# CVM du runner servant l'API (distincte de la démonstration), profil Phala CLI du compte sirius-ops.
SIRIUS_API_PHALA_PROFILE=REPLACE_PROFILE
SIRIUS_API_PHALA_CVM_ID=REPLACE_CVM_ID
SIRIUS_API_PHALA_APP_ID=REPLACE_APP_ID
# App ID de la CVM de démonstration (PHALA_DEMO_APP_ID du contrôleur démo), ou none s'il n'y en a aucune
# sur ce compte Phala : démarrage refusé s'il est égal à SIRIUS_API_PHALA_APP_ID ou absent.
SIRIUS_PHALA_DEMO_APP_ID=REPLACE_DEMO_APP_ID_OR_NONE
# Base de l'application (lecture des prêts, écriture de RunnerAvailability seulement).
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST/REPLACE_DB?sslmode=require
DATABASE_POOL_MAX=2
RUNNER_URL=https://REPLACE_RUNNER_ORIGIN
# Pins attestés du runner : mêmes valeurs que Next et le collecteur runner-monitor.env. Tous obligatoires,
# vérifiés au démarrage du contrôleur. RTMR3 n'est plus lu (change à chaque redémarrage, audit A-01).
SIRIUS_EXPECTED_MRTD=REPLACE_VERIFIED_MRTD
SIRIUS_EXPECTED_RTMR0=REPLACE_VERIFIED_RTMR0
SIRIUS_EXPECTED_RTMR1=REPLACE_VERIFIED_RTMR1
SIRIUS_EXPECTED_RTMR2=REPLACE_VERIFIED_RTMR2
SIRIUS_EXPECTED_OS_IMAGE_HASH=REPLACE_VERIFIED_OS_IMAGE_HASH
SIRIUS_EXPECTED_APP_ID=REPLACE_VERIFIED_APP_ID
SIRIUS_EXPECTED_COMPOSE_HASH=REPLACE_VERIFIED_COMPOSE_HASH
SIRIUS_EXPECTED_MASTER_KEY_CHAIN_SHA256=REPLACE_VERIFIED_CHAIN_HASH
NEXT_PUBLIC_SIRIUS_INGRESS_KEY_SHA256=REPLACE_VERIFIED_INGRESS_HASH
SIRIUS_LOCK_AUTHORIZER=REPLACE_RUNNER_SETTLEMENT_ADDRESS
EVM_NETWORK=testnet
EVM_RPC_URL=https://REPLACE_ARCHIVE_RPC
SIRIUS_ESCROW_ADDRESS=REPLACE_ESCROW
SIRIUS_DATASET_ADDRESS=REPLACE_DATASET_REGISTRY
SIRIUS_KYB_ADDRESS=REPLACE_KYB_REGISTRY
SIRIUS_USDC_ADDRESS=REPLACE_USDC
SIRIUS_COMPUTE_RECIPIENT=REPLACE_TREASURY
SIRIUS_BILLING_VERSION=7
TEE_MODE=phala
SIRIUS_REQUIRE_PHALA=true
