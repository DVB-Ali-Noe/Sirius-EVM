[Unit]
Description=Limite de durée de la session Phala Sirius
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/sirius/operations/session.json

[Service]
Type=oneshot
User=sirius-ops
WorkingDirectory=/opt/sirius
ExecStart=/usr/bin/node /opt/sirius/scripts/operations/phala-watchdog.mjs /etc/sirius/operations/session.json --apply-stop
TimeoutStartSec=75
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sirius-ops

