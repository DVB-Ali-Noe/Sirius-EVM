{
  "name": "sirius",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "runner:dev": "NODE_OPTIONS=\"--conditions=react-server --max-old-space-size=384\" node --import tsx src/runner/dev.ts",
    "reaper:start": "NODE_OPTIONS=\"--conditions=react-server\" node --import tsx src/worker/reaper.ts",
    "runner:smoke": "NODE_OPTIONS=\"--conditions=react-server\" node --import tsx src/runner/smoke.ts",
    "test": "NODE_OPTIONS=\"--conditions=react-server\" node --import tsx --test src/lib/http/security.test.ts src/lib/tee/identity.test.ts src/lib/tee/ingress.test.ts src/lib/tee/train.test.ts src/lib/runner/authorization.test.ts src/lib/runner/replay.test.ts src/lib/sirius/metrics.test.ts src/lib/sirius/reaper-policy.test.ts src/lib/sirius/reputation-policy.test.ts src/lib/sirius/provider.test.ts src/lib/sirius/borrower.test.ts src/lib/sirius/reaper.test.ts src/lib/sirius/settlement-policy.test.ts src/lib/tee/escrow-evm.test.ts src/lib/runner/capsule.test.ts src/lib/runner/evm-receipt.test.ts src/lib/errors-client.test.ts src/lib/evm/address.test.ts src/lib/evm/signature.test.ts src/lib/deployment-mode.test.ts src/lib/evm/addresses.test.ts src/lib/evm/usdc.test.ts src/lib/train/model-client.test.ts src/lib/train/evaluation-client.test.ts src/lib/train/benchmark-datasets.test.ts src/lib/wallet/manager.test.ts src/runner/server.test.ts",
    "test:e2e": "playwright test",
    "lint": "eslint",
    "contracts:compile": "cd contracts && hardhat compile",
    "contracts:test": "cd contracts && hardhat test",
    "contracts:abi": "node --import tsx contracts/scripts/export-abi.ts",
    "contracts:deploy:testnet": "node --import tsx contracts/scripts/deploy.ts",
    "contracts:bootstrap-demo": "node --import tsx contracts/scripts/bootstrap-demo.ts",
    "contracts:attest-kyb": "node --import tsx contracts/scripts/attest-kyb.ts",
    "contracts:smoke": "node --import tsx contracts/scripts/smoke.ts",
    "datasets:fetch": "node scripts/fetch-example-datasets.mjs && node scripts/split-example-datasets.mjs",
    "datasets:generate": "node scripts/generate-example-datasets.mjs && node scripts/split-example-datasets.mjs",
    "datasets:split": "node scripts/split-example-datasets.mjs",
    "datasets:benchmarks": "node scripts/generate-realistic-benchmarks.mjs",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "runner:capture-ra-tls": "NODE_OPTIONS=\"--conditions=react-server\" node --import tsx src/runner/capture-ra-tls.ts"
  },
  "dependencies": {
    "@phala/dcap-qvl": "^0.5.2",
    "@phala/dstack-sdk": "0.5.8",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.8.0",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "better-sqlite3": "^12.11.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "next": "16.2.11",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "three": "^0.183.1",
    "tsx": "^4.23.0",
    "viem": "^2.54.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "^3.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.183.0",
    "chai": "^4.5.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "hardhat": "^2.29.0",
    "playwright": "^1.61.1",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
